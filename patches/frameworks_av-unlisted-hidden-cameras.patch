+void CameraProviderManager::ProviderInfo::addUnlistedHiddenDevices(
+        const std::vector<std::string>& listedDevices) {
+    const std::string ranges = base::GetProperty("ro.camera.unlisted_hidden_ids", "");
+    if (ranges.empty() || listedDevices.empty()) {
+        return;
+    }
+
+    uint16_t major, minor;
+    std::string type, listedId;
+    if (parseDeviceName(listedDevices.front(), &major, &minor, &type, &listedId) != OK) {
+        return;
+    }
+
+    for (const auto& range : base::Split(ranges, ",")) {
+        const std::vector<std::string> bounds = base::Split(range, "-");
+        int first, last;
+        if (bounds.size() > 2 || !base::ParseInt(bounds.front(), &first, 0) ||
+                !base::ParseInt(bounds.back(), &last, first)) {
+            ALOGE("%s: Ignoring malformed unlisted camera id range '%s'", __FUNCTION__,
+                    range.c_str());
+            continue;
+        }
+        for (int id = first; id <= last; id++) {
+            if (mUniqueCameraIds.count(std::to_string(id)) > 0) {
+                continue;
+            }
+            const std::string name = "device@" + std::to_string(major) + "." +
+                    std::to_string(minor) + "/" + type + "/" + std::to_string(id);
+            std::string parsedId;
+            if (addDevice(name, CameraDeviceStatus::PRESENT, &parsedId) != OK) {
+                continue;
+            }
+            mDevices.back()->mSystemCameraKind = SystemCameraKind::HIDDEN_SECURE_CAMERA;
+            ALOGI("%s: Added unlisted camera %s as a hidden secure camera", __FUNCTION__,
+                    name.c_str());
+        }
+    }
+}
